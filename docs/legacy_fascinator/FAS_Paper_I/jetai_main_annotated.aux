\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The diffusion applicability boundary. (a) Preregistered confirmatory family: all four $\Delta $JCG negative (reverse-direction Holm $p{=}1.5\times 10^{-9}$); the only positive point is the shared-hub topology (star, single-weight $w{=}0.5$ design). (b) Weight sweep: both methods reach MRR${=}1.0$ together at $w{=}0.7$. (c) Dilution trade-off: the wider the spread, the flatter the target activation ($\rho {=}{-}0.445$, ${-}0.656$).}}{10}{figure.caption.9}\protected@file@percent }
\newlabel{fig:boundary}{{5}{10}{The diffusion applicability boundary. (a) Preregistered confirmatory family: all four $\Delta $JCG negative (reverse-direction Holm $p{=}1.5\times 10^{-9}$); the only positive point is the shared-hub topology (star, single-weight $w{=}0.5$ design). (b) Weight sweep: both methods reach MRR${=}1.0$ together at $w{=}0.7$. (c) Dilution trade-off: the wider the spread, the flatter the target activation ($\rho {=}{-}0.445$, ${-}0.656$)}{figure.caption.9}{}}
