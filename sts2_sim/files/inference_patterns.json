{
  "schema": "fas-sts2-kb/1.0",
  "version": "kb-0.1.0",
  "game": "Slay the Spire 2",
  "game_version": "STS2 Early Access (exact build unknown; sources cite patches v0.100.0-v0.103.2)",
  "patterns": [
    {
      "id": "P.expected_damage",
      "name": "Expected attack damage",
      "uses_mechanics": [
        "M.attack_damage",
        "M.vulnerable",
        "M.weak",
        "M.strength",
        "M.block"
      ],
      "binding_steps": [
        "bind card.damage parts to base/hit count",
        "read attacker strength, weak, target vulnerable, block",
        "apply modifiers per hit",
        "subtract block then HP"
      ],
      "computation": "per_hit=f(base,strength,weak,vuln); total=hits*per_hit; hp_loss=max(0,total-block)",
      "certainty_class": "direct_if_order_known",
      "uncertainty_sources": "modifier order/rounding unverified"
    },
    {
      "id": "P.multi_hit_scaling",
      "name": "Per-hit flat modifier scaling",
      "uses_mechanics": [
        "M.strength",
        "M.attack_damage"
      ],
      "binding_steps": [
        "identify hits count",
        "strength applied per hit (assumed)"
      ],
      "computation": "total=hits*(base+strength)*mods",
      "certainty_class": "direct_with_assumption",
      "uncertainty_sources": "STS2 order unverified"
    },
    {
      "id": "P.lethal_check",
      "name": "Lethal check",
      "uses_mechanics": [
        "M.attack_damage",
        "M.poison",
        "M.doom",
        "M.combat_end"
      ],
      "binding_steps": [
        "sum immediate damage",
        "add scheduled tick damage by timing",
        "compare doom to hp at check"
      ],
      "computation": "lethal_now=total>=hp+block; lethal_by_end_of_turn includes doom",
      "certainty_class": "direct",
      "uncertainty_sources": "timing differences between sources"
    },
    {
      "id": "P.debuff_before_burst",
      "name": "Order debuff before damage",
      "uses_mechanics": [
        "M.vulnerable",
        "M.attack_damage",
        "M.energy"
      ],
      "binding_steps": [
        "find debuff-applying and damage-dealing plays",
        "check energy",
        "simulate both orders"
      ],
      "computation": "gain=damage_after_debuff-damage_before",
      "certainty_class": "direct",
      "uncertainty_sources": "hit-by-hit rules"
    },
    {
      "id": "P.dot_total_damage",
      "name": "Poison projection",
      "uses_mechanics": [
        "M.poison"
      ],
      "binding_steps": [
        "read stacks N",
        "read ticks until fight end"
      ],
      "computation": "sum of N, N-1,... capped by fight length and extra triggers",
      "certainty_class": "estimate",
      "uncertainty_sources": "tick timing, Accelerant, fight length"
    },
    {
      "id": "P.dot_vs_block",
      "name": "Damage type routing",
      "uses_mechanics": [
        "M.poison",
        "M.doom",
        "M.block"
      ],
      "binding_steps": [
        "classify damage source as attack or not",
        "route around block when not attack"
      ],
      "computation": "effective_dot=dot (block not applied)",
      "certainty_class": "direct",
      "uncertainty_sources": "none identified"
    },
    {
      "id": "P.doom_threshold",
      "name": "Doom threshold",
      "uses_mechanics": [
        "M.doom",
        "M.attack_damage"
      ],
      "binding_steps": [
        "compare doom to enemy HP",
        "compute HP gap",
        "consider enemy healing and end-of-turn timing"
      ],
      "computation": "kill_at_end_of_enemy_turn if doom>=hp",
      "certainty_class": "direct",
      "uncertainty_sources": "timing wording conflict"
    },
    {
      "id": "P.block_sufficiency",
      "name": "Block sufficiency",
      "uses_mechanics": [
        "M.block",
        "M.enemy_intent",
        "M.weak",
        "M.osty_summon"
      ],
      "binding_steps": [
        "sum intended damage with modifiers",
        "subtract osty absorption if present",
        "compute needed block"
      ],
      "computation": "needed=max(0,incoming-block-osty_hp)",
      "certainty_class": "estimate",
      "uncertainty_sources": "hidden intents, overflow rules"
    },
    {
      "id": "P.overblock_waste",
      "name": "Overblock waste",
      "uses_mechanics": [
        "M.block",
        "M.enemy_intent"
      ],
      "binding_steps": [
        "compare block to incoming"
